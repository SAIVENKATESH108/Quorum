# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quorum
REDIS_URL=redis://localhost:6379/0

# LLM & External AI Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEURAL_PULSE_API_KEY=
NEURAL_PULSE_BASE_URL=https://pulse.evorozen.com/api/neural
NEURAL_PULSE_TIMEOUT_SECONDS=30.0

# Native Neon-backed authentication
AUTH_SECRET_KEY=replace_with_a_long_random_server_secret
ADMIN_EMAILS=admin@example.com
NEON_AUTH_URL=https://your-neon-auth-endpoint.example.com/neondb/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-endpoint.example.com/neondb/auth/.well-known/jwks.json
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-endpoint.example.com/neondb/auth

# Frontend / Client Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
# Use the deployed API host in Vercel, for example:
# NEXT_PUBLIC_API_URL=https://api.quorum-research.up.railway.app
# NEXT_PUBLIC_WS_URL=wss://api.quorum-research.up.railway.app/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
