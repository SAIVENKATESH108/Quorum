{
  "name": "quorum-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "build:web": "npm --workspace=apps/web run build",
    "lint:web": "npm --workspace=apps/web run lint",
    "build:types": "npm --workspace=packages/shared-types run build"
  }
}
